# LLM — Task 1.5 (คัดลอกเป็น .env แล้วใส่ key จริง)
# production: DeepSeek (ถูก ~10-20× ภาษาไทยดี) — https://api.deepseek.com/v1, model=deepseek-chat
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.nousresearch.com/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# ภาษาเริ่มต้นของแชท: th | zh | en
LLM_LOCALE=th

# Paid report delivery — ใช้ค่าสุ่มอย่างน้อย 24 ตัวอักษรและห้าม commit ค่าจริง
REPORT_ENTITLEMENT_SECRET=replace-with-a-long-random-secret

# Optional: เปลี่ยนตำแหน่ง cache ของ PDF ที่ตั้งชื่อด้วย artifact hash (ห้ามชี้ไปโฟลเดอร์ public)
REPORT_ARTIFACT_CACHE_DIR=data/cache/report-artifacts-v7
