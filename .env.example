# LLM — Task 1.5 (คัดลอกเป็น .env แล้วใส่ key จริง)
# production: DeepSeek (ถูก ~10-20× ภาษาไทยดี) — https://api.deepseek.com/v1, model=deepseek-chat
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.nousresearch.com/v1
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# ภาษาเริ่มต้นของแชท: th | zh | en
LLM_LOCALE=th

# Paid report delivery — ใช้ค่าสุ่มอย่างน้อย 24 ตัวอักษรและห้าม commit ค่าจริง
REPORT_ENTITLEMENT_SECRET=replace-with-a-long-random-secret

# Optional: เปลี่ยนตำแหน่ง cache ของ PDF ที่ตั้งชื่อด้วย artifact hash (ห้ามชี้ไปโฟลเดอร์ public)
REPORT_ARTIFACT_CACHE_DIR=data/cache/report-artifacts-v7

# Same-origin BFF / internal API boundary — ใช้ secret คนละค่าและอย่างน้อย 32 bytes
# BAZI_SESSION_SECRET ลงลายเซ็น anonymous session cookie (ยังไม่ใช่ account authentication)
BAZI_SESSION_SECRET=replace-with-at-least-32-random-bytes
API_INTERNAL_SECRET=replace-with-a-different-32-byte-secret
API_BASE=http://127.0.0.1:8787
API_HOST=127.0.0.1
# ปล่อยว่างเมื่อ backend รับเฉพาะ BFF; ห้ามใช้ * ใน production
API_CORS_ORIGIN=

# Research safety gates — default ต้องเป็น 0 จนกว่าจะผ่าน legal review และใช้ข้อมูลที่มีสิทธิ์ commercial
ENABLE_LEGACY_PERSONALIZED_PICKS=0
ENABLE_GENERIC_RESEARCH_DOSSIER=0
ENABLE_GENERIC_RESEARCH_SCREEN=0

# SEC fair-access identification for US security-master refreshes.
# Use a real monitored contact email; never commit the production value.
SEC_USER_AGENT="Bazi Investor Guide data pipeline contact@example.com"

# Licensed market-data adapter (ยังไม่เปิดจนกว่าสัญญาจะอนุญาต paid PDF/public display)
LICENSED_MARKET_DATA_PROVIDER=
LICENSED_MARKET_DATA_API_KEY=
LICENSED_MARKET_DATA_CONTRACT_REF=
LICENSED_MARKET_DATA_PAID_PDF_APPROVED=0
